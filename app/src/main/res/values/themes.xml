<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MuzPleer" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.MuzPleer.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Цвет фона заставки -->
        <item name="windowSplashScreenBackground">@color/colorPrimaryBlack</item>
        <!-- Иконка в центре -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/muz_player16</item>
        <!-- Цвет иконки (для Android 12+) -->
        <item name="windowSplashScreenIconBackgroundColor">@color/colorPrimary</item>
        <!-- Длительность показа -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <!-- Пост-заставка (можно оставить как фон) -->
        <item name="postSplashScreenTheme">@style/Theme.MuzPleer.NoActionBar</item>
    </style>

    <style name="Theme.MuzPleer.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MuzPleer.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>